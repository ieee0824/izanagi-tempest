(version 1)
(deny default)
(import "system.sb")
(allow process*)
(allow file-read-metadata)
(allow file-read* (subpath (param "JAIL")))
(allow file-write* (literal "/dev/null") (subpath (param "JAIL")))
(allow network-outbound (remote ip (param "RELAY")))
(allow network-outbound (literal (param "MCP_SOCKET")))
