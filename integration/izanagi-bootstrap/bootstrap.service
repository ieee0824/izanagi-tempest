# Review input only. Do not enable or install as a persistent service.
# Submit these fixed service properties as a transient unit after artifact audit.
[Unit]
Description=Fixed dummy Izanagi bootstrap validation

[Service]
Type=exec
User=tempest-kvm
Group=tempest-kvm
SupplementaryGroups=kvm
WorkingDirectory=/run/tempest-izanagi-bootstrap-002
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/nonexistent TMPDIR=/run/tempest-izanagi-bootstrap-002/tmp IZANAGI_SECRET_FILE=/run/tempest-izanagi-bootstrap-002/dummy.secret /var/lib/tempest-izanagi-bootstrap-002/probe
ExecStopPost=/usr/bin/python3 /var/lib/tempest-izanagi-bootstrap-002/record_exit.py
KillMode=control-group
RuntimeMaxSec=240s
TimeoutStopSec=5s
SendSIGKILL=yes
Restart=no
UMask=0077
NoNewPrivileges=yes
Delegate=no
